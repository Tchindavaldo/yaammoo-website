{
  "name": "yaammoo-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "npm run dev --workspace=@yaammoo/site",
    "dev:dashboard": "npm run dev --workspace=@yaammoo/dashboard",
    "build:site": "npm run build --workspace=@yaammoo/site",
    "build:dashboard": "npm run build --workspace=@yaammoo/dashboard"
  }
}
