// Cloudflare Worker (fichiers statiques) du dashboard — dashboard.yaammoo.rauval.com.
// Deploye par Workers Builds a chaque push sur main (Root directory : apps/dashboard).
// Voir architecture/monorepo.md.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "yaammoo-dashboard",
  "compatibility_date": "2026-10-01",
  // Domaine branche : pas d'URL de test workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dashboard.yaammoo.rauval.com", "custom_domain": true }],
  "build": {
    // Installe les workspaces depuis la racine puis build le dashboard.
    "command": "cd ../.. && npm ci && npm run build:dashboard"
  },
  "assets": {
    "directory": "./dist",
    // Remplace le rewrite SPA de vercel.json : toute URL inconnue sert index.html.
    "not_found_handling": "single-page-application"
  }
}
