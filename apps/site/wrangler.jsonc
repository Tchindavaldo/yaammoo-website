// Cloudflare Worker (fichiers statiques) de la vitrine — yaammoo.rauval.com.
// Deploye par Workers Builds a chaque push sur main (Root directory : apps/site).
// Voir architecture/monorepo.md.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "yaammoo-site",
  "compatibility_date": "2026-10-01",
  // Domaine branche : pas d'URL de test workers.dev (evite un doublon du site).
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "yaammoo.rauval.com", "custom_domain": true }],
  "build": {
    // Installe les workspaces depuis la racine puis build la vitrine.
    "command": "cd ../.. && npm ci && npm run build:site"
  },
  "assets": {
    "directory": "./dist",
    // Toutes les routes publiques sont prerendues (dist/<route>.html) : une URL
    // inconnue recoit dist/404.html avec un vrai statut 404 (pas de soft 404).
    "not_found_handling": "404-page"
  }
}
