# En-tetes HTTP du Worker Cloudflare yaammoo-site (fichiers statiques).
# Une en-tete definie par deux regles qui matchent est concatenee par
# Cloudflare : Cache-Control n'est donc jamais pose sur /*.
# Les pages HTML gardent le cache par defaut (revalidation a chaque visite).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Fichiers Vite (nom avec hash) : cache d'un an, jamais revalides.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images et icones (nom fixe) : 1 jour, puis revalidation en arriere-plan.
/og-image.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logo.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logo-256.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon-32x32.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/icon-192.png
